<view><view class="card-box"><view class="outer-box"><view class="title-box-num"><text class="title-words" style="font-weight:bold;">添加公司照片</text><text class="{{[(companyPhotoList.length<=10)?'num-words':'',(companyPhotoList.length>10)?'num-words-red':'']}}">{{"（"+companyPhotoList.length+"/10）"}}</text></view><view class="title-box"><text class="title-second">展现公司的各个方面与办公环境企业文化等，吸引更多优秀人才~</text></view></view></view><view class="photo-block"><view class="photo-box"><block wx:for="{{companyPhotoList}}" wx:for-item="photo" wx:for-index="index" wx:key="index"><view class="photo-wrapper"><image class="photo-item" src="{{photo}}"></image><image class="icon-delete" src="../../../static/icons/company/delete.png" data-event-opts="{{[['tap',[['removePhoto',[index]]]]]}}" bindtap="__e"></image></view></block><view class="business-license-wrapper"><image class="upload-icon" src="../../../static/images/upload.png" data-event-opts="{{[['tap',[['uploadPhoto']]]]}}" bindtap="__e"></image><text data-event-opts="{{[['tap',[['uploadPhoto']]]]}}" class="upload-words" bindtap="__e">添加照片</text></view></view></view></view>