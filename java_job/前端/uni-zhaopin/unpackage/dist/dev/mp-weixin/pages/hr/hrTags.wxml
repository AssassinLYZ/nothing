<view><view class="outer-box"><view class="title-box-num"><text class="title-words" style="font-weight:bold;">添加标签</text><text class="{{[(myTags.length<=10)?'num-words':'',(myTags.length>10)?'num-words-red':'']}}">{{"（"+myTags.length+"/10）"}}</text></view><view class="title-box"><text class="title-second">添加标签彰显你的独特个性，吸引更多优秀人才~</text></view></view><view class="outer-box" style="margin-top:12px;"><view class="all-tags"><block wx:for="{{myTags}}" wx:for-item="t" wx:for-index="index" wx:key="value"><view class="tag-box-selected" style="margin-top:10px;"><text class="tag-item-selected">{{t.value}}</text><image class="x" src="../../static/icons/x.png" data-event-opts="{{[['tap',[['deleteOneTag',['$0'],[[['myTags','value',t.value,'value']]]]]]]}}" bindtap="__e"></image></view></block></view></view><view class="outer-box" style="margin-top:30px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">个人身份</text></view><view class="all-tags"><block wx:for="{{personalStyle}}" wx:for-item="p" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['choosePersonalStyle',[index]]]]]}}" class="{{[(!p.isSelected)?'tag-box-unselected':'',(p.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{p.value}}</text></view></block></view></view><view class="outer-box" style="margin-top:30px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">管理风格</text></view><view class="all-tags"><block wx:for="{{managementStyle}}" wx:for-item="m" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['chooseManagementStyle',[index]]]]]}}" class="{{[(!m.isSelected)?'tag-box-unselected':'',(m.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{m.value}}</text></view></block></view></view><view class="outer-box" style="margin-top:30px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">性格特点</text></view><view class="all-tags"><block wx:for="{{characterStyle}}" wx:for-item="c" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['chooseCharacterStyle',[index]]]]]}}" class="{{[(!c.isSelected)?'tag-box-unselected':'',(c.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{c.value}}</text></view></block></view></view></view>