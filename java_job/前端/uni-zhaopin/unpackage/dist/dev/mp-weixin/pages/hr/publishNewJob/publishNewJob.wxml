<view><view class="card-box"><view class="title-wrapper"><text class="title-one">发布职位</text></view><view class="block-name" style="margin-top:30px;"><text class="field-lable-words">职位名称</text><input class="nickname-input" type="text" model="{{jobTitle}}" placeholder="请填入职位名称" placeholder-class="placeholder" maxlength="32" value="{{jobTitle}}"/></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">职位类别</text><view class="field-wrapper"><input class="company-input" type="text" model="{{jobType}}" placeholder="请选择职位类别" placeholder-class="placeholder" disabled="true" maxlength="12" data-event-opts="{{[['tap',[['gotoJobType']]]]}}" value="{{jobType}}" bindtap="__e"/><image class="right-arrow" src="../../../static/icons/right-arrow-gray.png" data-event-opts="{{[['tap',[['gotoJobType']]]]}}" bindtap="__e"></image></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="three-blocks"><view class="small-part"><text class="field-item-title">经验要求</text><picker class="picker-words" mode="selector" range="{{experienceRange}}" value="{{selectedExperienceIndex}}" data-event-opts="{{[['change',[['bindExperienceChange',['$event']]]]]}}" bindchange="__e"><view class="field-item-words">{{experienceRange[selectedExperienceIndex]}}</view></picker></view><view class="split placeholder">|</view><view class="small-part"><text class="field-item-title">最低学历</text><picker class="picker-words" mode="selector" range="{{educationRange}}" value="{{selectedEducationIndex}}" data-event-opts="{{[['change',[['bindEducationChange',['$event']]]]]}}" bindchange="__e"><view class="field-item-words">{{educationRange[selectedEducationIndex]}}</view></picker></view><view class="split placeholder">|</view><view class="small-part"><text class="field-item-title">{{"薪资"+(monthSalary==""?"范围":monthSalary)}}</text><picker class="{{[salary=='请选择'?'picker':'picker-words']}}" mode="multiSelector" range="{{salaryRange}}" value="{{salary}}" data-event-opts="{{[['change',[['bindSalaryChange',['$event']]]]]}}" bindchange="__e"><view class="field-item-words">{{salary}}</view></picker></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">职位描述</text><view class="field-wrapper"><input class="company-input" type="text" model="{{jobDescription}}" placeholder="请填写职位描述" placeholder-class="placeholder" disabled="true" maxlength="12" data-event-opts="{{[['tap',[['gotoJobDesc']]]]}}" value="{{jobDescription}}" bindtap="__e"/><image class="right-arrow" src="../../../static/icons/right-arrow-gray.png" data-event-opts="{{[['tap',[['gotoJobDesc']]]]}}" bindtap="__e"></image></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">职位标签</text><view class="field-wrapper"><input class="company-input" type="text" model="{{jobTags}}" placeholder="请选择合适的标签" placeholder-class="placeholder" disabled="true" data-event-opts="{{[['tap',[['gotoJobTags']]]]}}" value="{{jobTags}}" bindtap="__e"/><image class="right-arrow" src="../../../static/icons/right-arrow-gray.png" data-event-opts="{{[['tap',[['gotoJobTags']]]]}}" bindtap="__e"></image></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">工作地点</text><input class="position-input" type="text" model="{{workPlace}}" placeholder="请填写真实工作地点(具体到园区门牌号)" placeholder-class="placeholder" maxlength="64" value="{{workPlace}}"/></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="btn-next-wrapper" bindtap="__e"><text class="btn-next-words">发布职位</text></view></view></view>