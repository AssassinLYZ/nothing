<view><view class="card-box"><view class="title-wrapper" style="margin-bottom:50px;"><text class="title-one">所在行业</text><text class="title-two">请选择公司的行业，最多1项</text></view><block wx:for="{{industryArray}}" wx:for-item="i" wx:for-index="index" wx:key="id"><block><view class="main-item-box"><text class="main-item-words">{{i.value}}</text><block wx:if="{{i.id!=selectedIndustryId}}"><image class="arrow" src="../../../static/icons/arrow-close.png" data-event-opts="{{[['tap',[['openIndustry',['$0'],[[['industryArray','id',i.id]]]]]]]}}" bindtap="__e"></image></block><block wx:if="{{i.id==selectedIndustryId}}"><image class="arrow" src="../../../static/icons/arrow-open.png" data-event-opts="{{[['tap',[['closeIndustry',['$0'],[[['industryArray','id',i.id]]]]]]]}}" bindtap="__e"></image></block></view><view hidden="{{!(i.id==selectedIndustryId)}}" class="sub-item-wrapper"><block wx:for="{{subIndustryArray}}" wx:for-item="s" wx:for-index="index" wx:key="id"><view data-event-opts="{{[['tap',[['selectItem',['$0'],[[['subIndustryArray','id',s.id]]]]]]]}}" class="{{[selectedSubIndustryId==s.id?'sub-item-box-selected':'sub-item-box']}}" bindtap="__e"><text class="{{[selectedSubIndustryId==s.id?'sub-item-words-selected':'sub-item-words']}}">{{s.value}}</text></view></block></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view></block></block></view></view>