
.page {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: #ffffff;
}
.place-box {
	background-color: #4a4c52;
}
.place-box-touched {
	background-color: #6d6b6b;
}
.right-arrow {
	width: 32rpx;
	height: 32rpx;
	margin-left: 20rpx;
}
.active {
	background-color: #31B9B3;
	color: #ffffff;
}

