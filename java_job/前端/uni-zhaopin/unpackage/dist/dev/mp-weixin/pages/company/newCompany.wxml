<view><view class="card-box"><view class="title-wrapper"><text class="title-one">创建公司</text><text class="title-two">新创建的公司将会进行信息审核，请确保填入的信息真实有效</text></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">公司全称</text><text class="company-name">江苏非常牛的网络科技有限公司</text></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">公司简称</text><view class="field-wrapper"><input class="company-input" type="text" model="{{companyShortName}}" placeholder="请填写公司简称 (例：慕课网)" placeholder-class="placeholder" maxlength="36" value="{{companyShortName}}"/></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">公司行业</text><view class="field-wrapper"><input class="company-input" type="text" model="{{industry}}" placeholder="请选择公司行业" placeholder-class="placeholder" disabled="true" maxlength="12" value="{{industry}}"/><image class="right-arrow" src="../../static/icons/right-arrow-gray.png" data-event-opts="{{[['tap',[['gotoIndustry']]]]}}" bindtap="__e"></image></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><text class="field-lable-words">人员规模</text><view class="field-wrapper"><input class="company-input" type="text" model="{{staffCounts}}" placeholder="请选择人员规模" placeholder-class="placeholder" disabled="true" maxlength="12" value="{{staffCounts}}"/><image class="right-arrow" src="../../static/icons/right-arrow-gray.png" data-event-opts="{{[['tap',[['gotoStaffCounts']]]]}}" bindtap="__e"></image></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="block-name"><view class="field-wrapper" style="justify-content:space-between;"><view class="field-wrapper-biz"><text class="field-lable-words">营业执照</text><input class="company-input" type="text" placeholder="请上传企业营业执照" placeholder-class="placeholder" disabled="true" maxlength="12"/></view><view class="business-license-wrapper"><image class="business-license" src="{{businessLicense}}" data-event-opts="{{[['tap',[['uploadBusinessLicense']]]]}}" bindtap="__e"></image><image class="right-arrow" src="../../static/icons/right-arrow-gray.png" data-event-opts="{{[['tap',[['uploadBusinessLicense']]]]}}" bindtap="__e"></image><text style="width:5px;"></text></view></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view data-event-opts="{{[['tap',[['nextStep']]]]}}" class="btn-next-wrapper" bindtap="__e"><text class="btn-next-words">完成，下一步</text></view></view></view>