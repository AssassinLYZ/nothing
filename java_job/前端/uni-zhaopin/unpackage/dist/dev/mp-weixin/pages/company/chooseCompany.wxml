<view><view class="card-box"><view class="title-wrapper"><text class="title-one">选择公司</text></view><view class="company-wrapper"><image class="company-logo" src="../../static/images/imooc.png"></image><view class="company-box"><view class="company-name">慕课网</view><view class="company-info"><text class="industry">互联网·计算机</text><text class="counts">已有10位HR入驻</text></view></view></view><view class="line-wrapper" style="margin:20px 0;"><view class="line" style="width:100%;"></view></view><view class="title-wrapper" style="margin-top:50px;"><text class="title-one">入驻授权书</text><text class="title-two">企业需要对HR招聘授权方可入驻平台</text><view class="book-box"><text data-event-opts="{{[['tap',[['previewImage']]]]}}" class="title-three" bindtap="__e">查看示例图</text><text data-event-opts="{{[['tap',[['downloadTemplate']]]]}}" class="title-four" bindtap="__e">下载授权书模板</text></view></view><block wx:if="{{authLetter==null||authLetter==''}}"><view class="upload-box"><image class="upload-img" src="../../static/images/upload.png" data-event-opts="{{[['tap',[['uploadAuthLetter']]]]}}" bindtap="__e"></image><view data-event-opts="{{[['tap',[['uploadAuthLetter']]]]}}" class="upload-words" bindtap="__e"><text class="upload-words">上传授权书</text></view></view></block><block wx:if="{{authLetter!=null&&authLetter!=''}}"><image class="auth-letter" src="{{authLetter}}" data-event-opts="{{[['tap',[['uploadAuthLetter']]]]}}" bindtap="__e"></image></block><view data-event-opts="{{[['tap',[['confirmJoinCompany']]]]}}" class="btn-next-wrapper" bindtap="__e"><text class="btn-next-words">确认加入公司</text></view></view></view>