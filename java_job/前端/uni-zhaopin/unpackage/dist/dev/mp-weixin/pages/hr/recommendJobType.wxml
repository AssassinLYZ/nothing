<view><view class="all-in-box"><scroll-view class="left-main-scroll" style="{{'height:'+(screenHeight+'px')+';'}}" scroll-y="true"><block wx:for="{{mainTypeArray}}" wx:for-item="mainType" wx:for-index="index" wx:key="index"><block><view data-event-opts="{{[['tap',[['selectMainType',['$0'],[[['mainTypeArray','',index]]]]]]]}}" class="{{[selectedMainTypeId==mainType.id?'left-box-selected':'left-box']}}" bindtap="__e"><text class="left-words">{{mainType.value}}</text></view></block></block></scroll-view><scroll-view class="right-sub-scroll" style="{{'height:'+(screenHeight+'px')+';'}}" scroll-y="true"><block wx:for="{{subTypeArray}}" wx:for-item="subType" wx:for-index="index" wx:key="index"><view class="whole-sub-wrapper"><view class="sub-title-box"><text class="sub-title-words">{{subType.value}}</text></view><view class="third-box"><block wx:for="{{subType.thirdTypeArray}}" wx:for-item="thirdType" wx:for-index="index" wx:key="index"><block><view data-event-opts="{{[['tap',[['selectThirdType',['$0'],[[['subTypeArray','',index],['thirdTypeArray','',index]]]]]]]}}" class="{{[selectedThirdTypeId==thirdType.id?'third-lable-selected':'third-lable']}}" bindtap="__e"><text class="{{[selectedThirdTypeId==thirdType.id?'third-words-selected':'third-words']}}">{{thirdType.value}}</text></view></block></block></view></view></block></scroll-view></view></view>