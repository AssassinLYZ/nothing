<view><view class="navigation-bar" style="z-index:99999;"><text class="page-title">职位管理</text><view data-event-opts="{{[['tap',[['gotoPublishNewJob']]]]}}" class="publish-btn" bindtap="__e"><image class="publish-icon" src="../../static/icons/hr/publish.png" data-event-opts="{{[['tap',[['gotoPublishNewJob']]]]}}" bindtap="__e"></image></view></view><view class="tabs-box" style="z-index:888;"><view data-event-opts="{{[['tap',[['selectTab',[0]]]]]}}" class="tab-words-wrapper" bindtap="__e"><text class="{{[tabIndex==0?'tab-words-selected':'tab-words']}}">全部</text></view><view data-event-opts="{{[['tap',[['selectTab',[1]]]]]}}" class="tab-words-wrapper" bindtap="__e"><text class="{{[tabIndex==1?'tab-words-selected':'tab-words']}}">招聘中</text></view><view data-event-opts="{{[['tap',[['selectTab',[2]]]]]}}" class="tab-words-wrapper" bindtap="__e"><text class="{{[tabIndex==2?'tab-words-selected':'tab-words']}}">已关闭</text></view><view data-event-opts="{{[['tap',[['selectTab',[3]]]]]}}" class="tab-words-wrapper" bindtap="__e"><text class="{{[tabIndex==3?'tab-words-selected':'tab-words']}}">违规删除</text></view></view><scroll-view class="jobs" style="{{'padding-top:12px;'+('height:'+(scrollHeight+'px')+';')}}" scroll-y="true" refresher-enabled="{{isOpenRefresh}}" refresher-triggered="{{triggered}}" lower-threshold="50" data-event-opts="{{[['scroll',[['scroll',['$event']]]],['refresherpulling',[['onPulling',['$event']]]],['refresherrefresh',[['refreshJobList',['$event']]]],['scrolltolower',[['loadMoreJobs']]]]}}" bindscroll="__e" bindrefresherpulling="__e" bindrefresherrefresh="__e" bindscrolltolower="__e"><block wx:for="{{jobList}}" wx:for-item="j" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['gotoJobDetail',['$0'],[[['jobList','',index,'status']]]]]]]}}" class="job-box" bindtap="__e"><view class="title-line"><text class="title">{{j.title}}</text><text hidden="{{!(j.status==1)}}" class="job-status open">招聘中</text><text hidden="{{!(j.status==2)}}" class="job-status close">已关闭</text><text hidden="{{!(j.status==3)}}" class="job-status violate">违规不可发布</text></view><view class="info-line"><text class="info">{{j.city+" | "+j.education+" | "+j.workExperience+" | "+j.salary+"k·"+j.salaryMonth+"薪"}}</text></view><view class="line-wrapper" style="margin:12px 0;"><view class="line" style="width:100%;"></view></view></view></block></scroll-view></view>