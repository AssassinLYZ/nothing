<view><view class="outer-box"><view class="title-box-num"><text class="title-words" style="font-weight:bold;">公司亮点</text><text class="{{[(myTags.length<=10)?'num-words':'',(myTags.length>10)?'num-words-red':'']}}">{{"（"+myTags.length+"/10）"}}</text></view><view class="title-box"><text class="title-second">突出公司亮点，吸引更多优秀人才~</text></view></view><view class="outer-box" style="margin-top:12px;"><view class="all-tags"><block wx:for="{{myTags}}" wx:for-item="t" wx:for-index="index" wx:key="value"><view class="tag-box-selected" style="margin-top:10px;"><text class="tag-item-selected">{{t.value}}</text><image class="x" src="../../../static/icons/x.png" data-event-opts="{{[['tap',[['deleteOneTag',['$0'],[[['myTags','value',t.value,'value']]]]]]]}}" bindtap="__e"></image></view></block></view></view><view class="outer-box" style="margin-top:40px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">公司优势</text></view><view class="all-tags"><block wx:for="{{companyAdvantageList}}" wx:for-item="c" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['chooseCompanyAdvantage',[index]]]]]}}" class="{{[(!c.isSelected)?'tag-box-unselected':'',(c.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{c.value}}</text></view></block></view></view><view class="outer-box" style="margin-top:50px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">公司福利</text></view><view class="all-tags"><block wx:for="{{benefitList}}" wx:for-item="b" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['chooseBenefit',[index]]]]]}}" class="{{[(!b.isSelected)?'tag-box-unselected':'',(b.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{b.value}}</text></view></block></view></view><view class="outer-box" style="margin-top:50px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">薪资福利</text></view><view class="all-tags"><block wx:for="{{salaryList}}" wx:for-item="s" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['chooseSalary',[index]]]]]}}" class="{{[(!s.isSelected)?'tag-box-unselected':'',(s.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{s.value}}</text></view></block></view></view><view class="outer-box" style="margin-top:50px;"><view class="title-box-num"><text class="tag-title" style="font-weight:bold;">补助津贴</text></view><view class="all-tags"><block wx:for="{{subsidyList}}" wx:for-item="s" wx:for-index="index" wx:key="value"><view data-event-opts="{{[['tap',[['chooseSubsidy',[index]]]]]}}" class="{{[(!s.isSelected)?'tag-box-unselected':'',(s.isSelected)?'tag-box-selected':'']}}" style="margin-top:10px;" bindtap="__e"><text class="tag-item-selected">{{s.value}}</text></view></block></view></view></view>